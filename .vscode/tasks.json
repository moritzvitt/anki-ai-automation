{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format meta.json",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/format_meta_json.py",
        "meta.json"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Validate addon",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "py_compile",
        "__init__.py",
        "addon.py"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Package .ankiaddon",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/package_ankiaddon.py"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
